{
  "name": "agenda-whatsapp",
  "version": "0.1.0",
  "description": "SaaS multi-tenant de agendamento por WhatsApp (backend NestJS)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "comentario:lint": "lint roda o typecheck ANTES do eslint, e sem --fix. Sem --fix porque medicao nao conserta o que mede: com ele o verde seria o estado DEPOIS do conserto automatico, e nao o do codigo commitado. Typecheck junto porque nest build exclui os *.spec.ts, entao dava pra ter build verde com spec quebrada. Quem quer o conserto automatico chama lint:fix de proposito.",
    "lint": "npm run typecheck && eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "comentario:test": "test PROCURA os *.spec.ts em vez de ter a lista escrita. Os test:<nome> abaixo continuam pra rodar uma suite sozinha durante o desenvolvimento, mas quem responde \"os testes passam?\" e este.",
    "test": "node scripts/testes.mjs",
    "verificar": "node scripts/verificador.mjs",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "start:prod:migrate": "prisma migrate deploy && node dist/src/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "ts-node prisma/seed.ts",
    "test:engine": "ts-node src/availability/slot-engine.spec.ts",
    "test:pricing": "ts-node src/billing/pricing.spec.ts",
    "test:pricing-service": "ts-node src/pricing/service-price.spec.ts",
    "test:whatsapp-signature": "ts-node src/whatsapp/verify-signature.spec.ts",
    "test:agent-history": "ts-node src/agent/history.spec.ts",
    "test:whatsapp-parse": "ts-node src/whatsapp/parse-webhook.spec.ts",
    "test:booking-instant": "ts-node src/booking/validate-instant.spec.ts",
    "test:customer-token": "ts-node src/public/customer-token.spec.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@aws-sdk/client-s3": "^3.1079.0",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.20.0",
    "@types/web-push": "^3.6.4",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "luxon": "^3.5.0",
    "nodemailer": "^9.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^5.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.4.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.16.10",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2"
  }
}
