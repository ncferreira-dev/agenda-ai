// ---------------------------------------------------------------------------
// Schema do sistema de agendamento conversacional
// Multi-tenant: um Business = um comércio (barbearia, oficina, vet, etc.)
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Plano de assinatura do dono. Faixas por nº de profissionais (ver web/.../plans.ts).
enum Plan {
  START // 1 a 3 profissionais
  PRO   // 4 a 6 profissionais
  ULTRA // 7+ profissionais
}

// Estado da assinatura. Negócio novo nasce em TRIALING (14 dias de teste).
// ACTIVE/PAST_DUE/CANCELED só passam a ser escritos quando a cobrança entrar (Fase 5).
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

// Como o negócio atende. PRESENCIAL = cliente vai até o local (pede endereço);
// REMOTO = online (pede link de atendimento no lugar do endereço); HIBRIDO = os
// dois. Cada Service pode, no futuro, ter o próprio modo (null = herda o do negócio).
enum ServiceMode {
  PRESENCIAL
  REMOTO
  HIBRIDO
}

// Um comércio. Tudo é escopado por businessId (multi-tenant simples).
model Business {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // usado na URL da página de agendamento
  timezone  String   @default("America/Sao_Paulo")
  phone     String? // número de WhatsApp do negócio (o que recebe os agendamentos)
  address   String? // endereço do local de trabalho (mostrado pro cliente; só presencial/híbrido)

  // Tipo de atendimento do negócio (escolhido no cadastro). Adapta o resto:
  // REMOTO usa meetingUrl no lugar do endereço.
  serviceMode ServiceMode @default(PRESENCIAL)
  meetingUrl  String? // link do atendimento online (ex.: Google Meet); usado quando remoto/híbrido

  // Configuração de agenda
  slotStepMinutes   Int @default(15) // granularidade dos horários ofertados
  minLeadMinutes    Int @default(60) // antecedência mínima p/ agendar (não deixa marcar daqui a 5 min)
  maxAdvanceDays    Int @default(60) // até quantos dias pra frente pode agendar
  reminderHoursBefore Int @default(24) // quantas horas antes disparar o lembrete

  // Personalização (Nível 1) — a "cara do negócio" na página pública.
  logoUrl      String? // URL da logo
  coverUrl     String? // URL da capa/hero
  accentColor  String? // hex "#A6432B"; null cai no padrão
  about        String? // texto "Sobre"
  instagramUrl String? // link do Instagram
  profession   String? // profissão/ramo (ex.: "barbearia"); contexto pra sugestão de follow-up por IA
  themePreset  String? // "pele" visual da página pública: clean | bold | suave (ver src/presets/verticais.ts)

  // Onboarding "qual é o seu negócio?" (Fase 3b). null = ainda não concluiu o
  // wizard (o painel força a etapa); preenchido = já passou (ou pulou).
  onboardedAt DateTime?

  // Sinal (Fase 5) — cobrança no ato pra derrubar no-show.
  requireDeposit Boolean @default(false)
  depositCents   Int? // valor fixo do sinal por negócio

  // Segmentação de clientes (CRM). Limiares ajustáveis pelo dono.
  inactiveDays       Int  @default(60) // "Sumido" se a última visita passou disso
  vipMinSpentCents   Int? // VIP se o total gasto atingir isso; null = sem regra de gasto
  recurringMinVisits Int  @default(3)  // "Recorrente" a partir deste nº de visitas

  // Notificações pro dono (novo agendamento + resumo diário).
  notifyWhatsApp     Boolean   @default(true)  // avisar o dono no WhatsApp
  notifyEmail        Boolean   @default(false) // avisar o dono por e-mail
  notifyPush         Boolean   @default(false) // avisar o dono por Web Push (navegador/celular)
  notifyOwnerAllBookings Boolean @default(true) // dono recebe de TODOS os agendamentos; se off, só o profissional envolvido é avisado
  notifyDailySummary Boolean   @default(false) // resumo da agenda toda manhã
  ownerWhatsApp      String?   // WhatsApp do dono p/ avisos (E.164); null = usa o do perfil
  ownerEmail         String?   // e-mail do dono p/ avisos; null = usa o do perfil
  lastDailySummaryAt DateTime? // trava do resumo diário (não manda 2x no mesmo dia)

  // Assinatura do dono (subconjunto da Fase 5 — só armazenamento; cobrança/webhook
  // entram depois). Negócio novo começa em TRIALING com trialEndsAt em +14 dias.
  plan               Plan?              // null enquanto não assinou (ainda em trial)
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?          // fim do teste grátis; base p/ "faltam N dias"

  owners        Owner[]
  professionals Professional[]
  services      Service[]
  appointments  Appointment[]
  customers     Customer[]
  timeBlocks    TimeBlock[]
  recurringBlocks RecurringBlock[]
  conversations Conversation[]
  pushSubscriptions PushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Inscrição de Web Push do dono (uma por navegador/dispositivo que ativou o aviso).
// Escopada por businessId (multi-tenant). ownerId é só rastreio de qual dono ativou —
// scalar sem FK de propósito (não precisa de integridade referencial aqui).
model PushSubscription {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ownerId    String?  // dono que ativou (rastreio); null se não identificado

  endpoint   String   @unique // URL única do push service; chave natural do dispositivo
  p256dh     String   // chave pública do cliente (criptografia da mensagem)
  auth       String   // segredo de autenticação do cliente

  userAgent  String?  // p/ o dono reconhecer o dispositivo depois
  createdAt  DateTime @default(now())

  @@index([businessId])
}

// Dono do negócio: quem acessa o painel (app.*) com login + senha.
// 1↔1 com Business por ora; o businessId é o que escopa a sessão (JWT carrega ele).
model Owner {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  email        String  @unique
  // Opcional: quem entra só por login social (Google) nunca define senha.
  // Se null, o login por email/senha recusa e orienta a usar o botão social.
  passwordHash String? // hash argon2; senha em texto nunca é gravada nem logada
  name         String

  // Perfil do dono
  phone    String? // E.164
  // CPF nunca é gravado cru (LGPD). Guardamos só um blind index: HMAC-SHA256
  // determinístico (CPF_HASH_SECRET) que permite checar unicidade sem expor o
  // número. Ver src/common/cpf.ts.
  cpfHash  String? @unique
  cep      String? // só dígitos
  photoUrl String? // foto de perfil

  // Marca o instante da última troca de senha. Tokens (JWT) emitidos ANTES
  // disso deixam de valer (ver JwtStrategy) — invalida sessões antigas no reset.
  passwordChangedAt DateTime?

  createdAt      DateTime        @default(now())
  passwordResets PasswordReset[]
  oauthAccounts  OAuthAccount[]

  @@index([businessId])
}

// Provedor de login social vinculado a um Owner.
enum OAuthProvider {
  GOOGLE
}

// Conta social (Google) ligada a um Owner. Um Owner pode ter várias (um por
// provedor). É o que permite "vincular em vez de duplicar": se o email do
// Google já é de um Owner, criamos só um OAuthAccount apontando pra ele.
model OAuthAccount {
  id                String        @id @default(uuid())
  ownerId           String
  owner             Owner         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  provider          OAuthProvider
  providerAccountId String // o "sub" estável do provedor (não muda se o email mudar)
  email             String? // email retornado pelo provedor (informativo)
  createdAt         DateTime      @default(now())

  @@unique([provider, providerAccountId])
  @@index([ownerId])
}

// Code de uso único da troca pós-OAuth. O backend termina o fluxo social e
// gera um code curto; o front o troca pelo JWT (que aí vira o cookie httpOnly).
// Assim o token nunca viaja na URL. Guardamos só o SHA-256 do code (aleatório
// forte, não precisa de segredo), com expiração e uso único — igual PasswordReset.
model AuthExchange {
  id        String    @id @default(uuid())
  ownerId   String
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([ownerId])
}

// Pedido de redefinição de senha. O token cru viaja só no link do e-mail;
// aqui guardamos só o SHA-256 dele (token é aleatório forte, não precisa de
// segredo). Uso único (usedAt) e com expiração (expiresAt).
model PasswordReset {
  id        String    @id @default(uuid())
  ownerId   String
  owner     Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([ownerId])
}

// Quem executa o serviço (barbeiro, mecânico, esteticista...).
model Professional {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name     String
  active   Boolean @default(true)

  // Perfil do profissional — a foto aparece pro cliente na página de agendamento.
  phone    String? // WhatsApp/telefone do profissional, E.164 (uso interno; canal de aviso)
  email    String? // e-mail do profissional p/ aviso de novo agendamento (uso interno)
  cpf      String? // só dígitos (uso interno)
  photoUrl String? // foto de perfil (pública)

  workingHours WorkingHour[]
  services     ProfessionalService[]
  appointments Appointment[]
  timeBlocks   TimeBlock[]
  recurringBlocks RecurringBlock[]

  createdAt DateTime @default(now())

  @@index([businessId])
}

// Horário de trabalho recorrente por dia da semana.
// weekday: 0 = domingo ... 6 = sábado (padrão JS getDay / Luxon convertido)
// startMinute/endMinute: minutos desde 00:00 no fuso do negócio. Ex.: 9h = 540.
// Permite múltiplas faixas por dia (ex.: 9-12 e 13-18 com intervalo de almoço).
model WorkingHour {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  weekday     Int
  startMinute Int
  endMinute   Int

  @@index([professionalId, weekday])
}

// Serviço ofertado (corte, troca de óleo, banho e tosa...).
model Service {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name            String
  durationMinutes Int
  priceCents      Int     @default(0)
  active          Boolean @default(true)

  // Modo de atendimento por serviço (preparado pro futuro). null = herda o do negócio.
  serviceMode ServiceMode?

  // Follow-up de retorno: convidar o cliente a refazer o serviço depois de um tempo.
  followUpDays    Int?    // a cada quantos dias reconvidar; null = sem follow-up
  followUpMessage String? // mensagem tailored (placeholders {nome}/{servico}/{negocio}); null = template genérico

  professionals ProfessionalService[]
  appointments  Appointment[]

  createdAt DateTime @default(now())

  @@index([businessId])
}

// Quais profissionais executam quais serviços (N:N).
model ProfessionalService {
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
}

// Cliente final do comércio (identificado pelo telefone do WhatsApp).
model Customer {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name  String?
  phone String // E.164, ex.: 5511999998888
  email String? // opcional, p/ e-mail de confirmação
  ownerNote String? // observação PRIVADA do dono sobre o cliente (nunca exposta)

  appointments  Appointment[]
  conversations Conversation[]

  createdAt DateTime @default(now())

  @@unique([businessId, phone])
  @@index([businessId])
}

enum PaymentStatus {
  NONE // não exige sinal
  PENDING // aguardando pagamento do sinal
  PAID // sinal pago
}

enum AppointmentStatus {
  PENDING // criado, aguardando confirmação (se o negócio exigir)
  CONFIRMED // confirmado
  CANCELLED // cancelado
  COMPLETED // atendimento concluído
  NO_SHOW // cliente faltou
}

// O agendamento em si. startAt/endAt sempre em UTC; convertemos p/ o fuso na borda.
model Appointment {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id])

  startAt DateTime // UTC
  endAt   DateTime // UTC
  status  AppointmentStatus @default(CONFIRMED)
  notes   String? // a "observação" do cliente

  // Total do atendimento em centavos = soma dos AppointmentItem (denormalizado).
  // É o valor EDITADO (principal + itens acrescentados na hora) — fonte do
  // faturamento e da exibição. Mantido em transação quando os itens mudam.
  totalCents Int @default(0)

  // Controle de lembretes (pra não disparar duas vezes)
  reminderSentAt     DateTime?
  confirmationSentAt DateTime?
  customerConfirmedAt DateTime? // quando o cliente respondeu SIM ao lembrete
  followUpSentAt     DateTime? // quando disparou o convite de retorno (trava anti-duplo)

  // Sinal (Fase 5)
  paymentStatus   PaymentStatus @default(NONE)
  depositCents    Int? // valor do sinal cobrado neste agendamento
  stripeSessionId String? // Checkout Session do Stripe
  paidAt          DateTime?
  holdExpiresAt   DateTime? // se PENDING não pagar até aqui, libera o horário

  // Pagamento marcado À MÃO pelo dono no painel (independe do sinal/Stripe acima).
  // null = não pago; preenchido = pago (o timestamp serve de auditoria).
  manualPaidAt DateTime?

  items AppointmentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Acelera a query mais quente: conflitos do profissional num intervalo.
  @@index([professionalId, startAt])
  @@index([businessId, startAt])
}

// Itens cobrados num atendimento: o serviço principal (espelhado no ato do
// agendamento) + extras acrescentados na hora pelo dono. A soma vira o
// Appointment.totalCents. sourceServiceId aponta pro Service de origem quando o
// item nasceu de um serviço (alimenta "serviços mais feitos" no CRM); null em
// itens avulsos. Não tem relação formal pra não atrapalhar exclusão de Service.
model AppointmentItem {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  name            String
  priceCents      Int    @default(0)
  sourceServiceId String? // Service de origem (sem FK formal); null = item avulso

  createdAt DateTime @default(now())

  @@index([appointmentId])
}

// Bloqueios pontuais: folga, almoço extra, feriado, manutenção.
// Se professionalId for null, bloqueia o negócio inteiro (ex.: feriado).
model TimeBlock {
  id             String        @id @default(uuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  startAt DateTime // UTC
  endAt   DateTime // UTC
  reason  String?

  @@index([businessId, startAt])
  @@index([professionalId, startAt])
}

// Bloqueio RECORRENTE por dia da semana (almoço fixo, folga semanal, dia fechado).
// Diferente do TimeBlock (pontual): este se repete toda semana naquele weekday.
// weekday: 0 = domingo ... 6 = sábado (mesmo padrão do WorkingHour).
// startMinute/endMinute: minutos desde 00:00 no fuso do negócio. Ex.: 12h = 720.
// professionalId null = bloqueia o negócio inteiro nesse dia/horário.
model RecurringBlock {
  id             String        @id @default(uuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  weekday     Int
  startMinute Int
  endMinute   Int
  reason      String?

  createdAt DateTime @default(now())

  @@index([businessId, weekday])
  @@index([professionalId, weekday])
}

// Estado da conversa de WhatsApp por cliente. Guardamos o histórico
// pra dar contexto multi-turn ao agente (WhatsApp é conversa, não request único).
model Conversation {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  phone     String
  // Histórico no formato de mensagens da Anthropic API (role/content em JSON).
  messages  Json     @default("[]")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([businessId, phone])
  @@index([businessId, phone])
}

// Dedupe de webhooks já processados. A Meta reenvia o mesmo webhook em caso de
// timeout; sem isso a mensagem seria processada de novo (e respondida duas
// vezes). Persistir em tabela (em vez de um Set em memória) sobrevive a restart
// e funciona com múltiplas instâncias. A unicidade do providerMessageId é a
// trava: quem inserir primeiro processa; os demais batem no conflito e pulam.
model ProcessedWebhook {
  providerMessageId String   @id
  createdAt         DateTime @default(now())

  @@index([createdAt])
}
