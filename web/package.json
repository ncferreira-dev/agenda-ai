{
  "name": "agenda-whatsapp-web",
  "version": "0.1.0",
  "private": true,
  "description": "Página pública de agendamento (Next.js App Router)",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && next lint --max-warnings=0",
    "comentario:test": "vitest run (nao `vitest`) porque o modo watch nao TERMINA, e um comando que nao termina nao serve de portao no verificador nem no CI.",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/luxon": "^3.7.2",
    "luxon": "^3.7.2",
    "next": "^14.2.13",
    "qrcode": "^1.5.4",
