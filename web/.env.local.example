# Frontend (Next). Copie para .env.local.
#
# OBRIGATÓRIAS EM PRODUÇÃO (sem elas os links/chamadas caem em localhost):
#   NEXT_PUBLIC_API_BASE    — base da API no browser.
#   API_BASE                — base da API server-side (route handlers/painel).
#   NEXT_PUBLIC_SITE_ORIGIN — origem pública do site (monta os links de divulgação).

# Base da API do backend NestJS, usada no browser (página pública).
NEXT_PUBLIC_API_BASE="http://localhost:3000"
# Base da API usada server-side (route handlers / painel). Em dev é a mesma.
API_BASE="http://localhost:3000"
# Origem pública do site (painel/divulgar/aparência montam o link público a
# partir dela). Sem definir, os links apontam para http://localhost:3001.
NEXT_PUBLIC_SITE_ORIGIN="http://localhost:3001"
