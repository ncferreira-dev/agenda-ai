# Backend (NestJS) — copie para .env e preencha.

# Banco. Para o Postgres local do docker-compose abaixo, esta URL já funciona.
DATABASE_URL="postgresql://agenda:agenda@localhost:5432/agenda?schema=public"

# Porta do backend.
PORT=3000

# URL pública da API (usada pra montar a URL das imagens enviadas em /uploads).
PUBLIC_API_URL="http://localhost:3000"

# Stripe (Fase 5 — sinal). Use chaves de TESTE em dev.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Auth do dono (painel). Troque o segredo em produção.
JWT_SECRET="troque-isto-por-um-segredo-forte"
JWT_EXPIRES_IN="7d"

# Origem do frontend liberada no CORS (Next em dev).
WEB_ORIGIN="http://localhost:3001"

# Anthropic (agente conversacional). Sem isso, só o agente do WhatsApp deixa de
# funcionar; a página de agendamento (Fase 0) roda sem chave.
ANTHROPIC_API_KEY=""
AGENT_MODEL="claude-sonnet-4-6"

# WhatsApp Cloud API (Fase 4). Pode deixar vazio na Fase 0.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
