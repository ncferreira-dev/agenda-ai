# Backend (NestJS) — copie para .env e preencha.
#
# OBRIGATÓRIAS EM PRODUÇÃO (a API não sobe / não funciona sem elas):
#   DATABASE_URL      — string de conexão do Postgres.
#   JWT_SECRET        — segredo de assinatura do token do painel (app falha no boot se faltar).
#   CPF_HASH_SECRET   — blind index do CPF do dono (falha ao cadastrar CPF se faltar; DEFINITIVO).
#   WEB_ORIGIN        — domínio do frontend liberado no CORS.
#   PUBLIC_API_URL    — URL pública da API (monta a URL das imagens em /uploads).
# As demais são opcionais e degradam com elegância quando vazias.

# Banco. Para o Postgres local do docker-compose abaixo, esta URL já funciona.
DATABASE_URL="postgresql://agenda:agenda@localhost:5432/agenda?schema=public"

# Porta do backend.
PORT=3000

# URL pública da API (usada pra montar a URL das imagens enviadas em /uploads).
PUBLIC_API_URL="http://localhost:3000"

# Storage das imagens (logo/capa). Vazio = grava em disco local (uploads/), bom
# pra dev; EM DEPLOY EFÊMERO as imagens somem no restart. EM PRODUÇÃO configure um
# bucket S3-compatível (AWS S3, Cloudflare R2, Supabase, Backblaze, MinIO):
#   - defina S3_BUCKET (e credenciais) => uploads passam a ir pro bucket.
#   - S3_ENDPOINT: só pra provedores não-AWS (ex.: https://<conta>.r2.cloudflarestorage.com).
#   - S3_PUBLIC_URL: base pública/CDN dos objetos; se vazio, monta a URL do endpoint/bucket.
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# Web Push (aviso de novo agendamento no navegador/celular do dono). Vazio = não envia.
# Gere um par com: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:no-reply@agend.ai"

# E-mail de confirmação (SMTP). Vazio = não envia.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="agend.ai <no-reply@agend.ai>"

# Auth do dono (painel). OBRIGATÓRIO em produção: a API FALHA no boot se estiver
# vazio (sem ele qualquer um forjaria um token e assumiria qualquer tenant).
# Gere um segredo forte, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Blind index do CPF do dono (LGPD): HMAC do CPF, nunca o número cru.
# OBRIGATÓRIO e DEFINITIVO: defina um segredo forte ANTES do primeiro cadastro em
# produção e NUNCA o altere depois (mudar invalida todos os CPFs já gravados).
CPF_HASH_SECRET=""

# Login social do dono — Google (opcional). Vazio = o botão "Continuar com
# Google" fica indisponível e o email/senha segue normal. Credenciais criadas
# em console.cloud.google.com (OAuth 2.0, Aplicativo da Web). Redirect autorizado:
#   <PUBLIC_API_URL>/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Origem do frontend liberada no CORS (Next em dev).
WEB_ORIGIN="http://localhost:3001"

# Anthropic (agente conversacional). Sem isso, só o agente do WhatsApp deixa de
# funcionar; a página de agendamento (Fase 0) roda sem chave.
ANTHROPIC_API_KEY=""
AGENT_MODEL="claude-sonnet-4-6"

# WhatsApp Cloud API (Fase 4). Pode deixar vazio na Fase 0.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
